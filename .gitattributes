site/showcases/**/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
site/showcases/**/assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
site/showcases/**/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
site/showcases/**/screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
site/showcases/**/screenshots/**/*.jpg filter=lfs diff=lfs merge=lfs -text
site/showcases/**/screenshots/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
site/showcases/**/screenshots/**/*.webp filter=lfs diff=lfs merge=lfs -text
