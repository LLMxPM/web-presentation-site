{
  "title": {
    "text": "季度销售趋势",
    "left": "center",
    "textStyle": {
      "fontSize": 16,
      "color": "#333"
    }
  },
  "tooltip": {
    "trigger": "axis",
    "axisPointer": {
      "type": "cross",
      "crossStyle": {
        "color": "#999"
      }
    }
  },
  "legend": {
