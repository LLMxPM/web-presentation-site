      "barWidth": "40%",
      "label": {
        "show": true,
        "position": "top",
        "color": "#5470C6",
        "fontSize": 11
      }
    },
    {
      "name": "环比增长率",
      "type": "line",
      "yAxisIndex": 1,
      "data": [12, 18, 9, 21, 16, 22],
      "itemStyle": {
        "color": "#EE6666"
      },
      "lineStyle": {
        "width": 2.5
      },
      "symbol": "circle",
      "symbolSize": 8,
      "label": {
        "show": true,
        "position": "top",
        "color": "#EE6666",
        "fontSize": 11,
        "formatter": "{c}%"
      }
    }
