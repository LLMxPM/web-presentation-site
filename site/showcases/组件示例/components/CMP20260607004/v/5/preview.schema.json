{
  "props": {
    "images": {
      "type": "json",
      "label": "图片资源列表",
      "default": [
        "组件助手",
        "组件库",
        "资源助手",
        "资源库",
        "资源库"
      ]
    },
    "tiltAngle": {
      "type": "number",
      "label": "倾斜角度",
      "default": 25
    },
    "containerWidth": {
      "type": "string",
      "label": "组件整体宽度",
      "default": "1200px"
    },
    "containerHeight": {
      "type": "string",
      "label": "组件整体高度",
      "default": "420px"
    },
    "gap": {
      "type": "string",
      "label": "图片间距",
      "default": "24px"
    },
    "borderClass": {
      "type": "string",
      "label": "边框样式",
      "default": "rounded-xl shadow-lg"
    },
    "fitMode": {
      "type": "select",
      "label": "图片填充方式",
      "default": "cover",
      "options": [
        {
          "label": "裁切",
          "value": "cover"
        },
        {
          "label": "拉伸",
          "value": "fill"
        },
        {
          "label": "完整包含",
          "value": "contain"
        }
      ]
    }
  },
  "mocks": {},
  "presets": [
    {
